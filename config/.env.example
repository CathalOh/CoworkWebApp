# ---- app ----------------------------------------------------------------------------------
ENV=dev                                  # dev|test|prod (prod disables dev-login and requires KMS/HMAC keys)
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false                      # true behind TLS

# ---- storage ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_PATH=/data/objects
WORKSPACES_ROOT=/data/workspaces

# ---- identity (PingID: PingOne or PingFederate, OIDC Authorization Code + PKCE) ------------
OIDC_ISSUER=                             # e.g. https://auth.pingone.com/<envid>/as ; empty => dev-login only
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=                      # optional (public client + PKCE needs none)
OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/callback
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_TOKEN_VALIDATION=jwks               # jwks|introspection (introspection if Ping issues opaque access tokens)
AUTH_DEV_BYPASS=true                     # dev-login endpoint (ignored when ENV=prod)
ROLE_GROUP_MAP_JSON={"cw-org-admins":"org_admin","cw-workspace-admins":"workspace_admin","cw-team-leads":"team_lead","cw-auditors":"auditor","cw-developers":"developer"}

# ---- model provider: ILIAD via the Claude Agent SDK (primary path) -------------------------
MODEL_PROVIDER=iliad_anthropic           # iliad_anthropic | iliad_openai_compat | mock
AGENT_RUNTIME=agent_sdk                  # agent_sdk | deep_agents | mock
ILIAD_BASE_URL=http://mock-iliad:9100    # ILIAD's Anthropic-compatible root (=> ANTHROPIC_BASE_URL)
ILIAD_AUTH_TOKEN=mock                    # => ANTHROPIC_AUTH_TOKEN
ILIAD_CUSTOM_HEADERS=                    # "x-iliad-tenant: eng" => ANTHROPIC_CUSTOM_HEADERS
ILIAD_DISABLE_EXPERIMENTAL_BETAS=false   # true only if ILIAD rejects Anthropic beta headers
ILIAD_CA_CERT_PATH=                      # /certs/iliad-ca.pem => NODE_EXTRA_CA_CERTS
CLAUDE_AGENT_MODEL=claude-opus-5         # exact ID ILIAD accepts (no name translation!)
# ---- fallback: OpenAI-compatible gateway (LiteLLM in front of ILIAD) + Deep Agents ---------
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=

# ---- orchestration & quotas ---------------------------------------------------------------
DEFAULT_PERMISSION_MODE=default
MAX_CONCURRENT_RUNS_GLOBAL=8
MAX_CONCURRENT_RUNS_PER_USER=2
DEFAULT_MAX_BUDGET_USD=2.0
APPROVAL_TIMEOUT_SECONDS=1800
EVENT_RETENTION_SECONDS=86400

# ---- sandbox ------------------------------------------------------------------------------
SANDBOX_BACKEND=none                     # none (dev) | docker (per-run hardened container via docker socket)
SANDBOX_IMAGE=cowork-sandbox:latest
SANDBOX_CPU=1.0
SANDBOX_MEMORY=1g
SANDBOX_DISK=5g
SANDBOX_EGRESS_PROXY=http://egress-proxy:3128
SANDBOX_EGRESS_ALLOWLIST=                # extra hosts, comma separated (ILIAD is always allowed)

# ---- security -----------------------------------------------------------------------------
KMS_MASTER_KEY_B64=                      # base64 of 32 random bytes: openssl rand -base64 32 (REQUIRED in prod)
AUDIT_HMAC_KEY_B64=                      # base64 of 32 random bytes (REQUIRED in prod)
RATE_LIMIT_PER_MINUTE=240
EMBEDDING_PROVIDER=hash                  # hash (dev) | openai_compat (LITELLM /v1/embeddings)
EMBEDDINGS_DIM=1536
